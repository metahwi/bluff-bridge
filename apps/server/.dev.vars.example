# 이 파일을 .dev.vars 로 복사해서 값을 채운다. .dev.vars 는 Git에 올라가지 않는다.

# 로그인 세션 암호화 키 (32자 이상의 무작위 값)
BETTER_AUTH_SECRET=
# DB 테이블 생성(/api/admin/migrate)을 허용하는 비밀 값
ADMIN_TOKEN=

# 소셜 로그인. 값을 채운 것만 화면에 버튼이 나타난다.
# Google: 리디렉션 URI = http://localhost:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 카카오: Redirect URI = http://localhost:8787/api/auth/callback/kakao
# KAKAO_CLIENT_ID = REST API 키, KAKAO_CLIENT_SECRET = 보안 > Client Secret
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
