{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bluff-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  // 운영 D1 데이터베이스. 로컬 실행(wrangler dev)은 이 PC의 별도 파일을 쓰므로 운영 데이터를 건드리지 않는다.
  "d1_databases": [
    { "binding": "DB", "database_name": "bluff-bridge", "database_id": "736528c7-faf8-4075-a4d7-2db51d1f3549" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "GameRoom" },
      { "name": "MATCH", "class_name": "Matchmaker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] }
  ]
}
