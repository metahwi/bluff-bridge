{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bluff-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  // database_id는 5단계(배포)에서 실제 D1 데이터베이스의 ID로 바꾼다. 로컬 실행에는 영향이 없다.
  "d1_databases": [
    { "binding": "DB", "database_name": "bluff-bridge", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "GameRoom" },
      { "name": "MATCH", "class_name": "Matchmaker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] }
  ]
}
